{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/mcp",
      "destination": "/api/mcp.js"
    },
    {
      "source": "/api/health",
      "destination": "/api/health.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
